<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="create_wheels">

    <!-- ================= FRONT LEFT WHEEL ================= -->
    <link name="wheel_fl_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.08"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.08"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- Front Left Joint - DIRECTLY TO BASE_LINK -->
    <joint name="wheel_fl_joint" type="revolute">
      <parent link="base_link"/>
      <child link="wheel_fl_link"/>
      <origin xyz="0.20 0.20 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100.0" velocity="40.0" lower="-3.14159" upper="3.14159"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- ================= FRONT RIGHT WHEEL ================= -->
    <link name="wheel_fr_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.08"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.08"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- Front Right Joint - DIRECTLY TO BASE_LINK -->
    <joint name="wheel_fr_joint" type="revolute">
      <parent link="base_link"/>
      <child link="wheel_fr_link"/>
      <origin xyz="0.20 -0.20 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100.0" velocity="40.0" lower="-3.14159" upper="3.14159"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- ================= REAR LEFT WHEEL ================= -->
    <link name="wheel_bl_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.08"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.08"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- Rear Left Joint - DIRECTLY TO BASE_LINK -->
    <joint name="wheel_bl_joint" type="revolute">
      <parent link="base_link"/>
      <child link="wheel_bl_link"/>
      <origin xyz="-0.20 0.20 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100.0" velocity="40.0" lower="-3.14159" upper="3.14159"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- ================= REAR RIGHT WHEEL ================= -->
    <link name="wheel_br_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.08"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="0.1" length="0.08"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- Rear Right Joint - DIRECTLY TO BASE_LINK -->
    <joint name="wheel_br_joint" type="revolute">
      <parent link="base_link"/>
      <child link="wheel_br_link"/>
      <origin xyz="-0.20 -0.20 0.0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100.0" velocity="40.0" lower="-3.14159" upper="3.14159"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

  </xacro:macro>

</robot>