<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="create_arm">

    <!-- Joint 1: Base to Arm Link 1 -->
    <joint name="arm_joint_1" type="revolute">
      <parent link="arm_base_link"/>
      <child link="arm_link_1"/>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="50.0" velocity="2.0" lower="0.0" upper="1.5708"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- ================= ARM LINK 1 ================= -->
    <link name="arm_link_1">
      <visual>
        <origin xyz="0 0 0.125" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.25"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0.125" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.25"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0.125"/>
        <mass value="0.25"/>
        <inertia ixx="0.001458" iyy="0.001458" izz="0.0003125" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- Joint 2: Arm Link 1 to Arm Link 2 -->
    <joint name="arm_joint_2" type="revolute">
      <parent link="arm_link_1"/>
      <child link="arm_link_2"/>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="50.0" velocity="2.0" lower="0.0" upper="1.5708"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <!-- ================= ARM LINK 2 (GRABBER) ================= -->
    <link name="arm_link_2">
      <visual>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.12"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.12"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0.06"/>
        <mass value="0.1"/>
        <inertia ixx="0.0001825" iyy="0.0001825" izz="0.000125" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    
    <joint name="gripper_joint" type="revolute">
      <parent link="arm_link_2"/>
      <child link="gripper_link"/>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="1.0" velocity="0.01" lower="0" upper="0"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <!-- ================= GRIPPER LINK (EMPTY - FOR GRABBING) ================= -->
    <link name="gripper_link">
      <visual>
          <origin xyz="0 0 0.01" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="0.035" length="0.02"/>
          </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.02"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.01"/>
        <mass value="0.01"/>
        <inertia ixx="0.00001" iyy="0.00001" izz="0.00001" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

  </xacro:macro>

</robot>   