<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="create_arm">

    <link name="arm_link_1">
      <visual>
        <geometry>
          <mesh filename="package://sr_description/meshes/arm_link.dae" scale = "5 5 5"/>
        </geometry>
      </visual>
    </link>

    <link name="arm_link_2">
      <visual>
        <geometry>
          <mesh filename="package://sr_description/meshes/arm_elbow.dae" scale = "5 5 5"/>
        </geometry>
      </visual>
    </link>

    <joint name="arm_joint_1" type="continuous">
      <parent link="arm_base_link"/>
      <child link="arm_link_1"/>
      <origin xyz="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <joint name="arm_joint_2" type="continuous">
      <parent link="arm_link_1"/>
      <child link="arm_link_2"/>
      <origin xyz="0 0 0.22"/>
      <axis xyz="0 1 0"/>
    </joint>

  </xacro:macro>

</robot>
