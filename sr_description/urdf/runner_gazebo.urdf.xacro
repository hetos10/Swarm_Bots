<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gazebo_setup_run" params="robot_ns">
    <gazebo>
        <static>false</static>
    </gazebo>
 
    <gazebo reference="wheel_fl_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>

    <gazebo reference="wheel_fr_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>

    <gazebo reference="wheel_bl_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>

    <gazebo reference="wheel_br_link">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>

    <gazebo>
    
      <plugin filename="libignition-gazebo-joint-state-publisher-system.so" 
              name="ignition::gazebo::systems::JointStatePublisher">
      </plugin>
      <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
          <joint_name>wheel_fl_joint</joint_name>
          <topic>/model/runner1/joint/wheel_fl_joint/cmd_vel</topic>
      </plugin>
      <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
          <joint_name>wheel_fr_joint</joint_name>
          <topic>/model/runner1/joint/wheel_fr_joint/cmd_vel</topic>
      </plugin>
      <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
          <joint_name>wheel_bl_joint</joint_name>
          <topic>/model/runner1/joint/wheel_bl_joint/cmd_vel</topic>
      </plugin>
      <plugin filename="libignition-gazebo-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
          <joint_name>wheel_br_joint</joint_name>
          <topic>/model/runner1/joint/wheel_br_joint/cmd_vel</topic>
      </plugin>

      <plugin
        filename="libignition_link_attacher.so"
        name="ignition_link_attacher">
      </plugin>

      <plugin filename="libignition-gazebo-joint-controller-system.so"
              name="ignition::gazebo::systems::JointController">
          <joint_name>piston_rod_joint</joint_name>
          <cmd_vel_topic>/model/runner1/joint/piston_rod_joint/cmd_vel</cmd_vel_topic>
      </plugin>

 

      <plugin filename="libignition-gazebo-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
          <odom_topic>/runner1/odom</odom_topic>
          <odom_frame>odom</odom_frame>
          <robot_base_frame>base_footprint</robot_base_frame>
          <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>

    </gazebo>
  </xacro:macro>

  
</robot>