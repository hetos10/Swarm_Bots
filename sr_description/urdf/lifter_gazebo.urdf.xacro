<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gazebo_setup_lift" params="robot_ns">

    <gazebo reference="base_link">
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
    </gazebo>

    <gazebo reference="wheel_fl">
        <mu1>10.0</mu1>
        <mu2>10.0</mu2>
        <kp>100000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <fdir1>1 1 0</fdir1>
    </gazebo>

    <gazebo reference="wheel_fr">
        <mu1>10.0</mu1>
        <mu2>10.0</mu2>
        <kp>100000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <fdir1>1 -1 0</fdir1>
    </gazebo>

    <gazebo reference="wheel_bl">
        <mu1>10.0</mu1>
        <mu2>10.0</mu2>
        <kp>100000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <fdir1>1 -1 0</fdir1>
    </gazebo>

    <gazebo reference="wheel_br">
        <mu1>10.0</mu1>
        <mu2>10.0</mu2>
        <kp>100000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <fdir1>1 1 0</fdir1>
    </gazebo>

    <!-- Joint State Publisher -->
    <gazebo>
      <plugin filename="libignition-gazebo6-joint-state-publisher-system.so" name="ignition::gazebo::systems::JointStatePublisher">
      </plugin>
    </gazebo>

    <!-- Mecanum Drive Plugin - Handles all wheels and kinematics! -->
    <gazebo>
      <plugin filename="libignition-gazebo6-mecanum-drive-system.so" name="ignition::gazebo::systems::MecanumDrive">
        <front_left_joint>wheel_fl_joint</front_left_joint>
        <front_right_joint>wheel_fr_joint</front_right_joint>
        <back_left_joint>wheel_bl_joint</back_left_joint>
        <back_right_joint>wheel_br_joint</back_right_joint>
        <wheel_separation>0.4</wheel_separation>
        <wheel_diameter>0.2</wheel_diameter>
        <max_linear_speed>5.0</max_linear_speed>
        <max_angular_speed>5.0</max_angular_speed>
        <topic>${robot_ns}/cmd_vel</topic>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin filename="libignition-gazebo6-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
        <joint_name>arm_joint_1</joint_name>
        <topic>/${robot_ns}/cmd_shoulder</topic>
      </plugin>
      <plugin filename="libignition-gazebo6-joint-controller-system.so" name="ignition::gazebo::systems::JointController">
        <joint_name>arm_joint_2</joint_name>
        <topic>/${robot_ns}/cmd_elbow</topic>
      </plugin>
    </gazebo>

    <gazebo>
      <plugin filename="libignition-gazebo6-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
        <body_name>base_link</body_name>
        <odom_publish_frequency>100</odom_publish_frequency>
        <odom_topic>${robot_ns}/odom</odom_topic>
        <tf_topic>${robot_ns}/tf</tf_topic>
      </plugin>
    </gazebo>

    <gazebo reference="arm_base_link"/>
    <gazebo reference="arm_joint_1"/>
    <gazebo reference="arm_joint_2"/>

    <gazebo reference="arm_joint_1">
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>

    <gazebo reference="arm_joint_2">
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>


  </xacro:macro>
</robot>