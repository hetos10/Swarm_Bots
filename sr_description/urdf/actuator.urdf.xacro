<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piston">

  <!-- Piston parameters -->
  <xacro:property name="piston_base_length" value="0.05"/>
  <xacro:property name="piston_rod_length" value="0.1"/>
  <xacro:property name="piston_rod_radius" value="0.015"/>
  <xacro:property name="piston_base_radius" value="0.025"/>
  <xacro:property name="piston_mass" value="2.0"/>
  <xacro:property name="chassis_length" value="0.32"/>

  <xacro:macro name="create_piston">

    <!-- ================= BASE ================= -->
    <link name="piston_base">
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${piston_base_radius}"
                    length="${piston_base_length}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${piston_base_radius}"
                    length="${piston_base_length}"/>
        </geometry>
      </collision>
    </link>

    <!-- Fixed to wall -->
    <joint name="piston_base_joint" type="fixed">
      <parent link="back_wall"/>
      <child link="piston_base"/>
      <origin xyz="0.01 -0.15 0.06"/>
    </joint>

    <!-- ================= ROD ================= -->
    <link name="piston_rod">
      <inertial>
        <origin xyz="${piston_rod_length/2} 0 0" rpy="0 0 0"/>
        <mass value="${piston_mass}"/>
        <inertia
          ixx="${piston_mass * piston_rod_radius * piston_rod_radius / 4}"
          iyy="${piston_mass * (piston_rod_radius*piston_rod_radius + piston_rod_length*piston_rod_length) / 12}"
          izz="${piston_mass * (piston_rod_radius*piston_rod_radius + piston_rod_length*piston_rod_length) / 12}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>

      <!-- Rod starts at joint, extends forward -->
      <visual>
        <origin xyz="${piston_rod_length/2} 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="${piston_rod_radius}" length="${piston_rod_length}"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <origin xyz="${piston_rod_length/2} 0 0" rpy="0 1.5708 0"/>
        <geometry>
          <cylinder radius="${piston_rod_radius}" length="${piston_rod_length}"/>
        </geometry>
      </collision>
    </link>


    <!-- ================= PRISMATIC JOINT ================= -->
    <joint name="piston_rod_joint" type="prismatic">
      <parent link="piston_base"/>
      <child link="piston_rod"/>
      <origin xyz="0 0 0"/>
      <axis xyz="1 0 0"/>

      <!-- Starts retracted at 0 -->
      <limit lower="0" upper="${chassis_length}"
             effort="100" velocity="0.5"/>

      <dynamics damping="10" friction="0.5"/>
    </joint>

    <!-- ================= PUSHER HEAD ================= -->
    <link name="piston_head">
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.5"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>

      <visual>
        <geometry>
          <box size="0.04 0.18 0.05"/>
        </geometry>
        <material name="red"/>
      </visual>

      <collision>
        <geometry>
          <box size="0.04 0.18 0.05"/>
        </geometry>
      </collision>
    </link>

    <!-- Head at rod tip -->
    <joint name="piston_head_joint" type="fixed">
      <parent link="piston_rod"/>
      <child link="piston_head"/>
      <origin xyz="${piston_rod_length} 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
