<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="create_base">

    <link name="base_link">
      <visual>
        <origin xyz="0 0 0.1"/>
        <geometry>
          <box size="0.44 0.4 0.1"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0.1"/>
        <geometry>
          <box size="0.44 0.4 0.1"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="5.0"/>
        <inertia ixx="0.1" iyy="0.1" izz="0.1"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- arm mount -->
    <link name="arm_base_link"/>

    <joint name="arm_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="arm_base_link"/>
      <origin xyz="0.16 0 0.15"/>
    </joint>

  </xacro:macro>

</robot>
