<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="create_base">

    <!-- Ground reference frame -->
    <link name="base_footprint"/>

    <!-- Actual robot body -->
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.44 0.36 0.1"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <box size="0.44 0.36 0.1"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="5.0"/>
        <inertia ixx="0.1" iyy="0.1" izz="0.1"
                ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- base_link sits above ground -->
    <joint name="base_footprint_to_base_link" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0.05"/>
    </joint>

    <!-- ================= SHAFT LINKS ================= -->

    <!-- Shaft FL -->
    <link name="shaft_fl">
      <visual>
        <geometry>
          <mesh filename="package://sr_description/meshes/wheel_shaft.stl"
                scale="0.002 0.002 0.002"/>
        </geometry>
      </visual>
    </link>

    <joint name="shaft_fl_joint" type="fixed">
      <parent link="base_link"/>
      <child link="shaft_fl"/>
      <origin xyz="0.20 0.18 0.0"/>
    </joint>

    <!-- Shaft FR -->
    <link name="shaft_fr">
      <visual>
        <geometry>
          <mesh filename="package://sr_description/meshes/wheel_shaft.stl"
                scale="0.002 0.002 0.002"/>
        </geometry>
      </visual>
    </link>

    <joint name="shaft_fr_joint" type="fixed">
      <parent link="base_link"/>
      <child link="shaft_fr"/>
      <origin xyz="0.20 -0.18 0.0" rpy="0 0 3.1416"/>
    </joint>

    <!-- Shaft BL -->
    <link name="shaft_bl">
      <visual>
        <geometry>
          <mesh filename="package://sr_description/meshes/wheel_shaft.stl"
                scale="0.002 0.002 0.002"/>
        </geometry>
      </visual>
    </link>

    <joint name="shaft_bl_joint" type="fixed">
      <parent link="base_link"/>
      <child link="shaft_bl"/>
      <origin xyz="-0.20 0.18 0.0"/>
    </joint>

    <!-- Shaft BR -->
    <link name="shaft_br">
      <visual>
        <geometry>
          <mesh filename="package://sr_description/meshes/wheel_shaft.stl"
                scale="0.002 0.002 0.002"/>
        </geometry>
      </visual>
    </link>

    <joint name="shaft_br_joint" type="fixed">
      <parent link="base_link"/>
      <child link="shaft_br"/>
      <origin xyz="-0.20 -0.18 0.0" rpy="0 0 3.1416"/>
    </joint>

    <!-- ================= ARM MOUNT ================= -->

    <link name="arm_base_link"/>

    <joint name="arm_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="arm_base_link"/>
      <origin xyz="0.16 0 0.06"/>
    </joint>

  </xacro:macro>

</robot>
