<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gazebo_setup">

  <!-- ========================================
       GAZEBO SPECIFIC SETUP
       NO VISUAL/COLLISION HERE - DEBUGGING FRIENDLY
       ======================================== -->

  <xacro:macro name="gazebo_setup">

    <!-- Differential Drive Plugin -->
    <gazebo>
      <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
        
        <!-- Wheel joints -->
        <left_joint>wheel_fl_joint</left_joint>
        <right_joint>wheel_fr_joint</right_joint>
        
        <!-- Kinematics -->
        <wheel_separation>0.40</wheel_separation>
        <wheel_diameter>0.10</wheel_diameter>
        
        <!-- Limits -->
        <max_wheel_torque>20</max_wheel_torque>
        <max_wheel_acceleration>10</max_wheel_acceleration>
        
        <!-- Frames -->
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_link</robot_base_frame>
        
        <!-- ROS interface -->
        <ros>
          <remapping>cmd_vel:=cmd_vel</remapping>
          <remapping>odom:=odom</remapping>
        </ros>
        
        <!-- Output -->
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>
        
      </plugin>
    </gazebo>

    <!-- Base link material -->
    <gazebo reference="base_link">
      <material>Gazebo/Grey</material>
      <mu1>0.2</mu1>
      <mu2>0.2</mu2>
    </gazebo>

    <!-- Wheel materials and friction -->
    <gazebo reference="wheel_fl">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="wheel_fr">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="wheel_bl">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="wheel_br">
      <mu1>1.5</mu1>
      <mu2>1.5</mu2>
      <material>Gazebo/Black</material>
    </gazebo>

  </xacro:macro>

</robot>