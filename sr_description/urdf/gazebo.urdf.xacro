<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gazebo_setup">

    <!-- ================= BASE ================= -->
    <gazebo reference="base_link">
      <material>Gazebo/Grey</material>
      <mu1>0.3</mu1>
      <mu2>0.3</mu2>
    </gazebo>

    <!-- ================= MECANUM WHEELS ================= -->
    <gazebo reference="wheel_fl">
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
      <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="wheel_fr">
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
      <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="wheel_bl">
      <mu1>2.0</mu1>
      <mu2>2.0</mu2>
      <material>Gazebo/Black</material>
    </gazebo>

    <gazebo reference="wheel_br">
      <mu1>2.0</mu2>
      <mu2>2.0</mu2>
      <material>Gazebo/Black</material>
    </gazebo>

    <!-- ================= ARM LINKS ================= -->
    <gazebo reference="arm_base_link">
      <material>Gazebo/Blue</material>
      <mu1>0.5</mu1>
      <mu2>0.5</mu2>
    </gazebo>

    <gazebo reference="arm_shoulder_link">
      <material>Gazebo/Orange</material>
      <mu1>0.5</mu1>
      <mu2>0.5</mu2>
    </gazebo>

    <gazebo reference="arm_elbow_link">
      <material>Gazebo/Orange</material>
      <mu1>0.5</mu1>
      <mu2>0.5</mu2>
    </gazebo>

    <gazebo reference="arm_wrist_link">
      <material>Gazebo/Yellow</material>
      <mu1>0.4</mu1>
      <mu2>0.4</mu2>
    </gazebo>

    <gazebo reference="gripper_link">
      <material>Gazebo/Red</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
    </gazebo>

    <!-- ================= ARM JOINT DYNAMICS ================= -->
    <gazebo reference="shoulder_joint">
      <provideFeedback>true</provideFeedback>
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>

    <gazebo reference="elbow_joint">
      <provideFeedback>true</provideFeedback>
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>

    <gazebo reference="wrist_joint">
      <provideFeedback>true</provideFeedback>
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>

    <!-- ================= BASIC ODOM (TEMP DEBUG) ================= -->
    <gazebo>
      <plugin name="odom_plugin" filename="libgazebo_ros_p3d.so">
        <bodyName>base_link</bodyName>
        <topicName>odom</topicName>
        <frameName>odom</frameName>
        <updateRate>50.0</updateRate>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
