              </ode>
            </contact>
          </surface>
        </collision>
        
        <!-- ===== INERTIAL (Mass and Moment) ===== -->
        <inertial>
          <mass>0.1</mass>
          <pose>0 0 0 0 0 0</pose>
          <inertia>
            <ixx>0.04167</ixx>
            <iyy>0.04167</iyy>
            <izz>0.04167</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
