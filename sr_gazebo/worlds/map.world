<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="ignition-gazebo-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin name="ros2_linkattacher" filename="libgazebo_link_attacher.so"/>
    <scene>
      <grid>false</grid>
      <ambient>0.1 0.1 0.2</ambient>
      <background>0.05 0.05 0.1</background>
      <shadows>false</shadows>
      <!-- <sky>
        <time>22</time>
        <sunrise>6</sunrise>
        <sunset>18</sunset>
        <clouds>false</clouds>
      </sky> -->
    </scene>

    <include>
      <pose>0 0 2.8 0 0 0</pose>
      <uri>model://sun</uri>
    </include>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.0001 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <name>arena_terrain</name>
      <pose>0 0 0.001 0 0 -1.5708</pose>
      <uri>model://arena_terrain</uri>
    </include>

    <model name='crate_red_1'>
      <static>false</static>
      <pose>4.7 4.9 0.2 0 0 0</pose>
      
      <link name='box_link'>
        <!-- ===== VISUAL (Appearance) ===== -->
        <visual name='visual'>
          <pose>0 0 0 0 0 0</pose>
          <cast_shadows>true</cast_shadows>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.0 0.0 1.0</ambient>
            <diffuse>1.0 0.0 0.0 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <emissive>0.0 0.0 0.0 1.0</emissive>
          </material>
        </visual>
        
        <!-- ===== COLLISION (Physics) ===== -->
        <collision name='collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>0.7</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <kp>1e13</kp>
                <kd>1.0</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.0</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        
        <!-- ===== INERTIAL (Mass and Moment) ===== -->
        <inertial>
          <mass>0.1</mass>
          <pose>0 0 0 0 0 0</pose>
          <inertia>
            <ixx>0.04167</ixx>
            <iyy>0.04167</iyy>
            <izz>0.04167</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>
    
    <!-- ==================== BOX 2 (GREEN) - For Pair 2 (Lifter2) ==================== -->
    <model name='crate_green_2'>
      <static>false</static>
      <pose>4.7 4.4 0.2 0 0 0</pose>
      
      <link name='box_link'>
        <!-- ===== VISUAL (Appearance) ===== -->
        <visual name='visual'>
          <pose>0 0 0 0 0 0</pose>
          <cast_shadows>true</cast_shadows>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.8 0.0 1.0</ambient>
            <diffuse>0.0 1.0 0.0 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <emissive>0.0 0.0 0.0 1.0</emissive>
          </material>
        </visual>
        
        <!-- ===== COLLISION (Physics) ===== -->
        <collision name='collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>0.7</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <kp>1e13</kp>
                <kd>1.0</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.0</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        
        <!-- ===== INERTIAL (Mass and Moment) ===== -->
        <inertial>
          <mass>0.1</mass>
          <pose>0 0 0 0 0 0</pose>
          <inertia>
            <ixx>0.04167</ixx>
            <iyy>0.04167</iyy>
            <izz>0.04167</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>
    
    <!-- ==================== BOX 3 (BLUE) - For Pair 3 (Lifter3) ==================== -->
    <model name='crate_blue_3'>
      <static>false</static>
      <pose>4.7 3.3 0.2 0 0 0</pose>
      
      <link name='box_link'>
        <!-- ===== VISUAL (Appearance) ===== -->
        <visual name='visual'>
          <pose>0 0 0 0 0 0</pose>
          <cast_shadows>true</cast_shadows>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 0.8 1.0</ambient>
            <diffuse>0.0 0.0 1.0 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <emissive>0.0 0.0 0.0 1.0</emissive>
          </material>
        </visual>
        
        <!-- ===== COLLISION (Physics) ===== -->
        <collision name='collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>0.7</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <kp>1e13</kp>
                <kd>1.0</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.0</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        
        <!-- ===== INERTIAL (Mass and Moment) ===== -->
        <inertial>
          <mass>0.1</mass>
          <pose>0 0 0 0 0 0</pose>
          <inertia>
            <ixx>0.04167</ixx>
            <iyy>0.04167</iyy>
            <izz>0.04167</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>
    
    <!-- ==================== BOX 4 (YELLOW) - For Pair 4 (Lifter4) ==================== -->
    <model name='crate_yellow_4'>
      <static>false</static>
      <pose>4.7 2.8 0.2 0 0 0</pose>
      
      <link name='box_link'>
        <!-- ===== VISUAL (Appearance) ===== -->
        <visual name='visual'>
          <pose>0 0 0 0 0 0</pose>
          <cast_shadows>true</cast_shadows>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.0 1.0</ambient>
            <diffuse>1.0 1.0 0.0 1.0</diffuse>
            <specular>0.5 0.5 0.5 1.0</specular>
            <emissive>0.0 0.0 0.0 1.0</emissive>
          </material>
        </visual>
        
        <!-- ===== COLLISION (Physics) ===== -->
        <collision name='collision'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.25 0.25 0.25</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>0.7</mu2>
                <slip1>0.0</slip1>
                <slip2>0.0</slip2>
              </ode>
            </friction>
            <contact>
              <ode>
                <soft_cfm>0.0</soft_cfm>
                <soft_erp>0.2</soft_erp>
                <kp>1e13</kp>
                <kd>1.0</kd>
                <max_vel>0.01</max_vel>
