<?xml version='1.0'?>
<sdf version='1.8'>
  <model name='arena_terrain'>
    <static>1</static>
    <link name="link">
      <collision name="floor_collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>2.4384 2.4384</size>
          </plane>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>50</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      
      
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://arena_terrain/meshes/arena_terrain.dae</uri>
            <scale>5 5 1</scale>

          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>

